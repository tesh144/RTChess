# Kitchen Counter
# Simple geometric counter - 1x1 grid unit
# Color: Wood brown (apply in Unity)

# Vertices
v -0.5 0.0 -0.5    # Base corners
v 0.5 0.0 -0.5
v 0.5 0.0 0.5
v -0.5 0.0 0.5
v -0.5 0.9 -0.5    # Top corners
v 0.5 0.9 -0.5
v 0.5 0.9 0.5
v -0.5 0.9 0.5
v -0.45 0.95 -0.45  # Counter top (slightly larger)
v 0.45 0.95 -0.45
v 0.45 0.95 0.45
v -0.45 0.95 0.45

# Faces (counter body)
f 1 2 6 5    # Front
f 2 3 7 6    # Right
f 3 4 8 7    # Back
f 4 1 5 8    # Left
f 1 4 3 2    # Bottom
f 5 6 7 8    # Body top

# Counter top surface
f 9 10 11 12  # Top surface
f 5 9 12 8    # Top edges
f 5 6 10 9
f 6 7 11 10
f 7 8 12 11
